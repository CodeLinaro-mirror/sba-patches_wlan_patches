+                        len += buf;
+                        break;
+                    }
+                }
+
+                hHal = WLAN_HDD_GET_HAL_CTX( useAdapter );
+                pMac = PMAC_STRUCT( hHal );
+                pHddStaCtx = WLAN_HDD_GET_STATION_CTX_PTR( useAdapter );
