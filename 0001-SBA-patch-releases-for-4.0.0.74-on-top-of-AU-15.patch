+          "%s: Not able to post WDA_TRIGGER_BATCH_SCAN_RESULT_IND message"
+          " to WDA", __func__);
+        vos_mem_free(pRequestBuf);
+        return eHAL_STATUS_FAILURE;
+    }
+
+    return eHAL_STATUS_SUCCESS;
+}
