-      PELOGE(limLog(pMac, LOGE,FL("session does not exist for given bssId"));)
-      return eSIR_FAILURE;
-   }
+      pBcnReport->numBssDesc = (pBcnReport->numBssDesc == RRM_BCN_RPT_NO_BSS_INFO)?
+                               RRM_BCN_RPT_MIN_RPT : pBcnReport->numBssDesc;
+
