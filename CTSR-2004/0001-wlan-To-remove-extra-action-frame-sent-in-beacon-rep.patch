-#endif
-   limSendRadioMeasureReportActionFrame( pMac,
-                                         pCurrentReq->dialog_token,
-                                         bssDescCnt,
-                                         pReport,
-                                         pBcnReport->bssId,
-                                         pSessionEntry );
+      limLog( pMac, LOG1, "Sending Action frame with %d bss info", bssDescCnt);
+      limSendRadioMeasureReportActionFrame( pMac,
