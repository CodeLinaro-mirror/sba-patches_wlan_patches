++                   }
++                }
++            }
++
++            if (i == tail)
++            {
++                break;
++            }
++            i += 1;
++
++            spin_lock(&ltraceLock);
++            if (MAX_VOS_TRACE_RECORDS == i)
++            {
++                i = 0;
++                pRecord= gvosTraceTbl[0];
++            }
++            else
++            {
++                pRecord = gvosTraceTbl[i];
++            }
++            spin_unlock(&ltraceLock);
++        }
++    }
++    else
++    {
++        spin_unlock(&ltraceLock);
++    }
