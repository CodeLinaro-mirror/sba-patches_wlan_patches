+                   tANI_U8 sessionId)
+{
+    tpHalHiddenSsidVdevRestart pHalHiddenSsidVdevRestart = NULL;
+    tSirMsgQ       msgQ;
+    tSirRetStatus  retCode = eSIR_SUCCESS;
+
+    if ( psessionEntry == NULL )
