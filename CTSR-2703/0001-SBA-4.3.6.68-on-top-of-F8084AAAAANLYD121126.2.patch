++                    "%s: Waiting for active entry points to exit", __func__);
++            msleep(SSR_WAIT_SLEEP_TIME);
++        }
++    }
++    /* at least one external thread is executing */
++    if (!count)
++        return false;
++
++   VOS_TRACE(VOS_MODULE_ID_HDD, VOS_TRACE_LEVEL_INFO,
++             "Allowing SSR for %s", caller_func);
++
++    return true;
++}
