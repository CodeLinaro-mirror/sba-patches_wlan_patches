+-    if(traceCBTable[module] == NULL)
+-        return;
+-    pe_AcquireGlobalLock( &pMac->lim );
+-
+-    gTraceData.num++;
+-
+-    if (gTraceData.head == INVALID_TRACE_ADDR)
+-    {
+-        /* first record */
+-        gTraceData.head = 0;
+-        gTraceData.tail = 0;
+-    }
+-    else
+-    {
+-        /* queue is not empty */
+-        tANI_U32 tail = gTraceData.tail + 1;
